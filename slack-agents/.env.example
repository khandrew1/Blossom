# Required: bot token for the Slack app whose bot identity is Jenny.
SLACK_JENNY_BOT_TOKEN=xoxb-replace-with-jenny-bot-token

# Required: bot token for the Slack app whose bot identity is Ryan.
SLACK_RYAN_BOT_TOKEN=xoxb-replace-with-ryan-bot-token

# Required: ID (not name) of the private demo channel, e.g. C0123456789.
SLACK_DEMO_CHANNEL_ID=C0123456789

# Optional. For phone access, set this to this computer's Tailscale IPv4 address.
# Leaving it unset binds only to this computer (127.0.0.1).
HOST=127.0.0.1
PORT=8787
